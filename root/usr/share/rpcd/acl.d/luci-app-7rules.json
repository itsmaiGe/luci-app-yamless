{
	"luci-app-7rules": {
		"description": "Grant access to the 分流规则 (split rules) page",
		"read": {
			"ubus": {
				"file": [ "read" ],
				"uci": [ "get" ]
			},
			"file": {
				"/etc/openclash/config/7rules.yaml": [ "read" ],
				"/etc/openclash/proxy_provider/7rules-*": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ]
			},
			"uci": [ "openclash", "dhcp" ]
		},
		"write": {
			"ubus": {
				"file": [ "write", "exec" ]
			},
			"file": {
				"/tmp/7rules.yaml": [ "write" ],
				"/usr/libexec/7rules-fetch *": [ "exec" ],
				"/usr/libexec/7rules-apply": [ "exec" ]
			}
		}
	}
}
