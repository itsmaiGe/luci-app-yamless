{
	"luci-app-yamless": {
		"description": "Grant access to YAMLess",
		"read": {
			"ubus": {
				"file": [ "read" ],
				"uci": [ "get" ]
			},
			"file": {
				"/etc/openclash/config/yamless.yaml": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ]
			},
			"uci": [ "openclash", "dhcp" ]
		},
		"write": {
			"ubus": {
				"file": [ "write", "exec" ]
			},
			"file": {
				"/tmp/yamless.yaml": [ "write" ],
				"/usr/libexec/yamless": [ "exec" ]
			}
		}
	}
}
